# Copy to .env for local development. Values in this file are development-only
# placeholders; do not use them for a deployed environment.
COMPOSE_PROJECT_NAME=cliprank

RAILS_ENV=development
WEB_PORT=3000
ML_PORT=8000

POSTGRES_DB=cliprank_development
POSTGRES_USER=cliprank
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cliprank:replace-with-a-local-postgres-password@db:5432/cliprank_development
QUEUE_DATABASE_URL=postgresql://cliprank:replace-with-a-local-postgres-password@db:5432/cliprank_development_queue
SECRET_KEY_BASE=replace-with-a-long-random-development-secret

S3_ENDPOINT=http://storage:9000
S3_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=cliprank-development
S3_ACCESS_KEY_ID=cliprank-local
S3_SECRET_ACCESS_KEY=replace-with-a-local-minio-password
MINIO_ROOT_USER=cliprank-local
MINIO_ROOT_PASSWORD=replace-with-a-local-minio-password
AWS_REGION=us-east-1

ML_BASE_URL=http://ml:8000
ML_SERVICE_TOKEN=replace-with-a-local-ml-service-token

# Optional provider settings consumed by the ML service when enabled.
TRANSCRIPTION_PROVIDER=
TRANSCRIPTION_API_KEY=
SEMANTIC_PROVIDER=
SEMANTIC_API_KEY=
