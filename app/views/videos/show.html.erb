<% content_for :title, "#{@video.title} · ClipRank" %>

<% if @ranking_run.present? && @preview_pending %>
  <% content_for :head do %>
    <meta http-equiv="refresh" content="10">
  <% end %>
<% end %>

<main class="page-shell">
  <%= link_to "← Back to videos", videos_path, class: "back-link" %>
  <div class="page-heading">
    <div><p class="eyebrow">Video analysis</p><h1><%= @video.title %></h1><p class="lede">Uploaded <%= l(@video.created_at, format: :long) %></p></div>
    <span class="status status-<%= @video.status %>"><%= @video.status.humanize %></span>
  </div>
  <section class="detail-card">
    <h2>Processing status</h2>
    <p class="status-message">
      <% if @video.failed? %>
        We couldn't finish this analysis.
      <% elsif @video.complete? %>
        Your analysis is ready.
      <% else %>
        ClipRank is working through your recording. This page is safe to refresh.
      <% end %>
    </p>
    <% safe_error = @video.processing_error_message.presence || @processing_run&.error_message.presence %>
    <% if safe_error.present? %><div class="error-summary" role="alert"><%= safe_error %></div><% end %>
    <% if @processing_run.present? %>
      <dl class="metadata">
        <div><dt>Run status</dt><dd><%= @processing_run.status.humanize %></dd></div>
        <div><dt>Pipeline</dt><dd><%= @processing_run.pipeline_version %></dd></div>
        <% if @processing_run.current_stage.present? %><div><dt>Current stage</dt><dd><%= @processing_run.current_stage.humanize %></dd></div><% end %>
      </dl>
    <% end %>
  </section>

  <% if @ranked_scores.any? %>
    <section class="results-section" aria-live="polite" aria-label="Ranked clip results">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Evidence-backed ranking</p>
          <h2>Top clips</h2>
          <p class="section-lede">The strongest moments are ranked from the persisted transcript, feature measurements, and score components.</p>
          <% if @results_fallback %><p class="fallback-notice" role="status">Showing the latest successful ranking while the newest processing run is unavailable.</p><% end %>
        </div>
        <span class="result-count"><%= @ranked_scores.size %> of <%= @ranking_run.candidate_scores.count %> shown</span>
      </div>

      <% if @preview_pending %>
        <div class="preview-refresh-notice" role="status">
          <span aria-hidden="true" class="refresh-dot"></span>
          <span>Preview rendering is in progress. This page refreshes automatically.</span>
          <%= link_to "Refresh now", video_path(@video), class: "button button-small" %>
        </div>
      <% end %>

      <ol class="results-list">
        <% @ranked_scores.each do |score| %>
          <% clip = score.candidate_clip %>
          <% artifacts = @preview_artifacts_by_candidate.fetch(clip.id, {}) %>
          <% preview_artifact = artifacts["preview"] %>
          <% thumbnail_artifact = artifacts["thumbnail"] %>
          <% media_ready = preview_artifact&.ready? && preview_artifact.file.attached? && thumbnail_artifact&.ready? && thumbnail_artifact.file.attached? %>
          <% artifact_failed = [preview_artifact, thumbnail_artifact].compact.find(&:failed?) %>
          <% artifact_rendering = [preview_artifact, thumbnail_artifact].compact.any?(&:rendering?) %>
          <% explanation = score.explanations.find { |item| item.explanation_version == Explanations::Generator::VERSION } || score.explanations.max_by(&:created_at) %>
          <li class="result-card <%= "result-card-top-#{score.rank}" if score.rank <= 3 %>">
            <div class="result-rank" aria-label="Rank <%= score.rank %>"><span>#</span><%= score.rank %></div>
            <div class="result-main">
              <div class="result-header">
                <div>
                  <p class="result-kicker"><%= score.rank <= 3 ? "Top #{score.rank}" : "Rank #{score.rank}" %></p>
                  <h3><%= clip_timestamp(clip.start_ms) %>–<%= clip_timestamp(clip.end_ms) %></h3>
                </div>
                <div class="clip-score"><strong><%= score_percent(score.clip_score) %></strong><span>/ 100</span><small>ClipScore</small></div>
              </div>

              <div class="preview-panel" aria-label="Clip preview">
                <% if media_ready %>
                  <figure class="clip-media">
                    <%= image_tag video_preview_artifact_path(@video, thumbnail_artifact), alt: "Thumbnail for clip from #{clip_timestamp(clip.start_ms)} to #{clip_timestamp(clip.end_ms)}", loading: "lazy", referrerpolicy: "no-referrer" %>
                    <figcaption>Preview · <%= clip_timestamp(clip.start_ms) %>–<%= clip_timestamp(clip.end_ms) %></figcaption>
                  </figure>
                  <video controls preload="metadata" poster="<%= video_preview_artifact_path(@video, thumbnail_artifact) %>" referrerpolicy="no-referrer" aria-label="Preview of clip from <%= clip_timestamp(clip.start_ms) %> to <%= clip_timestamp(clip.end_ms) %>">
                    <source src="<%= video_preview_artifact_path(@video, preview_artifact) %>" type="video/mp4">
                    Your browser does not support video playback.
                  </video>
                <% elsif artifact_failed %>
                  <div class="preview-placeholder preview-failed" role="alert">
                    <strong>Preview unavailable</strong>
                    <span><%= artifact_failed.error_message.presence || "We couldn't render this clip preview." %></span>
                  </div>
                <% elsif artifact_rendering %>
                  <div class="preview-placeholder preview-rendering" role="status">
                    <strong>Rendering preview…</strong>
                    <span>Your clip is being prepared.</span>
                  </div>
                <% elsif @video.failed? %>
                  <div class="preview-placeholder preview-failed" role="alert">
                    <strong>Preview unavailable</strong>
                    <span>The preview pipeline did not complete for this run.</span>
                  </div>
                <% else %>
                  <div class="preview-placeholder preview-queued" role="status">
                    <strong>Preview queued</strong>
                    <span>ClipRank will render this clip shortly.</span>
                  </div>
                <% end %>
              </div>

              <p class="result-transcript"><%= clip.transcript %></p>

              <dl class="component-grid" aria-label="Score components">
                <% [["Content quality", score.content_quality], ["Hook", score.hook], ["Delivery", score.delivery], ["Pacing", score.pacing], ["Visual engagement", score.visual_engagement], ["Standalone clarity", score.standalone_clarity]].each do |label, value| %>
                  <div><dt><%= label %></dt><dd><%= score_percent(value) %></dd></div>
                <% end %>
              </dl>

              <% if explanation.present? %>
                <div class="explanation-block">
                  <h4>Why this ranks here</h4>
                  <p><%= explanation.summary %></p>
                  <div class="evidence-columns">
                    <% if explanation.strengths.any? %>
                      <div><h5>Strengths</h5><ul><% explanation.strengths.each do |item| %><li><%= item["text"] %></li><% end %></ul></div>
                    <% end %>
                    <% if explanation.weaknesses.any? %>
                      <div><h5>Watch-outs</h5><ul><% explanation.weaknesses.each do |item| %><li><%= item["text"] %></li><% end %></ul></div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </li>
        <% end %>
      </ol>
    </section>
  <% elsif @results_pending || @video.complete? %>
    <section class="empty-state results-empty" aria-live="polite"><h2>Results are almost ready</h2><p>ClipRank is preparing the evidence-backed ranking for this recording.</p></section>
  <% end %>
</main>
